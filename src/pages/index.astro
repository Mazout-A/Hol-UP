---
import Layout from "../layouts/Layout.astro";
---

<Layout title="English Game">
    <main class="game">
        <!-- Avant le premier tirage : la place de la carte est marquée -->
        <div id="card-back" class="card_back">
            <p>Draw your first card to start</p>
        </div>

        <article id="card" class="card" aria-live="polite" hidden>
            <div class="card_interne">
                <h2 id="title" class="card_title"></h2>

                <div class="card_effet">
                    <p class="card_score">
                        <span id="score"></span>
                        <span id="score-label"></span>
                    </p>
                </div>

                <p id="text" class="card_text"></p>

                <div class="card_infos">
                    <p id="year" class="card_year"></p>

                    <a
                        id="source"
                        class="card_source"
                        href="#"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        Source
                    </a>
                </div>
            </div>
        </article>
    </main>

    <div class="buttons">
        <button id="draw" class="btn btn_draw">
            Draw a card
        </button>
        <p id="round" aria-live="polite"></p>
        <button id="reset" class="btn btn_reset" hidden>
            New game
        </button>
    </div>
</Layout>

<script>
    import "../scripts/draw.js";
</script>
