---
import Layout from "../layouts/Layout.astro";
import cards from "../data/cards.json";
---

<Layout title="English Game">
    <!-- <ul>
        {cards.map((card) => (
            <li>
                {card.year} : {card.title.en}
            </li>
        ))}
    </ul> -->

    <button id="draw">Draw a card</button>

    <p>
        <i data-lucide="calendar"></i> <span id="date"></span>
    </p>
    <p>
        <i data-lucide="gauge"></i> <span id="score"></span>
    </p>
    <span id="category-icon"></span>
    <span id="trend-icon"></span>

    <article id="card">
        <p id="year"></p>
        <h2 id="title"></h2>
        <p id="text"></p>
        <iframe
            id="video"
            hidden
            title="Video"
            allowfullscreen
            referrerpolicy="strict-origin-when-cross-origin"
            style="width: 100%; aspect-ratio: 16 / 9; border: 0;"
        >
            </iframe>
        <a id="source" href="#" target="_blank" rel="">
            Read source
        </a>
    </article>

    <p id="round"></p>
    <button id="reset" hidden>
        Reset
    </button>
</Layout>

<script>
    import "../scripts/draw.js";
</script>
