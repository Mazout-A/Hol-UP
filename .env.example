# Copie ce fichier en « .env » pour tester le formulaire « Add an event » en local avec GitHub,
# et saisis les mêmes valeurs dans Vercel (Settings > Environment Variables).
# Le fichier .env n'est jamais envoyé sur GitHub (il est dans .gitignore). Ne partage jamais le jeton.

# Jeton GitHub « fine-grained » limité à CE dépôt, avec :
#   Contents : Read and write   |   Pull requests : Read and write
GITHUB_TOKEN=

# Dépôt qui reçoit les propositions, au format propriétaire/dépôt
GITHUB_REPO=Mazout-A/Hol-UP

# Branche principale (facultatif, « main » par défaut)
GITHUB_BASE_BRANCH=main
